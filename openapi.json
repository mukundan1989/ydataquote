{
  "openapi": "3.0.3",
  "info": {
    "title": "Y Fin Latest Quote",
    "description": "Latest available stock prices and historical daily close prices for 1\u201320 symbols. Choose a period or start/end dates for history. Results are timestamped JSON. Historical interval is 1d only. Prices may be delayed; coverage is not guaranteed. Authenticate using your RapidAPI subscription key through the RapidAPI gateway.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/quotes": {
      "get": {
        "tags": [
          "Stock Prices"
        ],
        "summary": "Latest Stock Quotes",
        "description": "Latest timestamped quote metadata or latest valid one-minute close, including extended hours.",
        "operationId": "LatestStockQuotes",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Comma-separated Yahoo symbols; 1\u201320 entries. URL-encode & as %26.",
              "title": "Symbols"
            },
            "description": "Comma-separated Yahoo symbols; 1\u201320 entries. URL-encode & as %26."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/history": {
      "get": {
        "tags": [
          "Stock Prices"
        ],
        "summary": "Historical Daily Close Prices",
        "description": "Daily close-price series (1d only). Supply period OR both start/end.\n\nDate mode forwards period1/period2 to Spark and filters returned points to [start,end).\nCoverage is not verified; unsupported requests fail without fallback or extra calls.",
        "operationId": "HistoricalDailyClosePrices",
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Use instead of start/end dates",
              "title": "Period",
              "$ref": "#/components/schemas/Period",
              "nullable": true
            },
            "description": "Use instead of start/end dates"
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Inclusive UTC date",
              "title": "Start",
              "type": "string",
              "format": "date",
              "nullable": true
            },
            "description": "Inclusive UTC date"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Exclusive UTC date",
              "title": "End",
              "type": "string",
              "format": "date",
              "nullable": true
            },
            "description": "Exclusive UTC date"
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Interval",
              "default": "1d"
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Comma-separated Yahoo symbols; 1\u201320 entries. URL-encode & as %26.",
              "title": "Symbols"
            },
            "description": "Comma-separated Yahoo symbols; 1\u201320 entries. URL-encode & as %26."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClosePoint": {
        "properties": {
          "timestamp": {
            "type": "integer",
            "title": "Timestamp"
          },
          "time_utc": {
            "type": "string",
            "title": "Time Utc"
          },
          "close": {
            "type": "number",
            "title": "Close"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "time_utc",
          "close"
        ],
        "title": "ClosePoint"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryResponse": {
        "properties": {
          "fetched_at_utc": {
            "type": "string",
            "title": "Fetched At Utc"
          },
          "data_calls": {
            "type": "integer",
            "title": "Data Calls"
          },
          "requested_symbols": {
            "type": "integer",
            "title": "Requested Symbols"
          },
          "successful_symbols": {
            "type": "integer",
            "title": "Successful Symbols"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/HistoryResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "fetched_at_utc",
          "data_calls",
          "requested_symbols",
          "successful_symbols",
          "results"
        ],
        "title": "HistoryResponse"
      },
      "HistoryResult": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "currency": {
            "title": "Currency",
            "type": "string",
            "nullable": true
          },
          "exchange_timezone": {
            "title": "Exchange Timezone",
            "type": "string",
            "nullable": true
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/ClosePoint"
            },
            "type": "array",
            "title": "Data"
          },
          "coverage_verified": {
            "type": "boolean",
            "title": "Coverage Verified"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "any_error": {
            "title": "Any Error",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "status",
          "data",
          "coverage_verified",
          "warnings"
        ],
        "title": "HistoryResult"
      },
      "Interval": {
        "type": "string",
        "enum": [
          "1d"
        ],
        "title": "Interval"
      },
      "Period": {
        "type": "string",
        "enum": [
          "1d",
          "5d",
          "1mo",
          "3mo",
          "6mo",
          "1y",
          "2y",
          "5y",
          "10y",
          "ytd",
          "max"
        ],
        "title": "Period"
      },
      "QuoteResponse": {
        "properties": {
          "fetched_at_utc": {
            "type": "string",
            "title": "Fetched At Utc"
          },
          "data_calls": {
            "type": "integer",
            "title": "Data Calls"
          },
          "requested_symbols": {
            "type": "integer",
            "title": "Requested Symbols"
          },
          "successful_symbols": {
            "type": "integer",
            "title": "Successful Symbols"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/QuoteResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "fetched_at_utc",
          "data_calls",
          "requested_symbols",
          "successful_symbols",
          "results"
        ],
        "title": "QuoteResponse"
      },
      "QuoteResult": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "price": {
            "title": "Price",
            "type": "number",
            "nullable": true
          },
          "price_time_utc": {
            "title": "Price Time Utc",
            "type": "string",
            "nullable": true
          },
          "price_age_seconds": {
            "title": "Price Age Seconds",
            "type": "integer",
            "nullable": true
          },
          "currency": {
            "title": "Currency",
            "type": "string",
            "nullable": true
          },
          "any_error": {
            "title": "Any Error",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "status"
        ],
        "title": "QuoteResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://ydataquote.vercel.app"
    }
  ]
}
