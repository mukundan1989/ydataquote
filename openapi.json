{
  "openapi": "3.0.3",
  "info": {
    "title": "Y Fin Latest Quote",
    "description": "Fetch historical daily close prices. Choose either a period or a date range. You can fetch upto 20 symbols.",
    "version": "1.0.2"
  },
  "paths": {
    "/v1/quotes": {
      "get": {
        "tags": [
          "Stock Prices"
        ],
        "summary": "Latest Stock Quotes",
        "description": "Latest quotes with timestamp.",
        "operationId": "LatestStockQuotes",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Comma-separated symbols. Add up to 20 symbols. Example: MSFT,TSLA,INFY.",
              "title": "Symbols"
            },
            "description": "Comma-separated symbols. Add up to 20 symbols. Example: MSFT,TSLA,INFY."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/history": {
      "get": {
        "tags": [
          "Stock Prices"
        ],
        "summary": "Historical Daily Close Prices",
        "description": "Fetch historical daily close prices. Choose either a period or a date range.\n\nA complete date range overrides period. Empty period and dates use 5d.\nYou can fetch up to 20 symbols. Interval must be 1d.",
        "operationId": "HistoricalDailyClosePrices",
        "parameters": [
          {
            "name": "interval",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Available option: 1d (daily closes only).",
              "default": "1d",
              "title": "Interval"
            },
            "description": "Available option: 1d (daily closes only)."
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Available options: 1d, 5d, 1mo, 3mo, 6mo, 1y, 2y, 5y, 10y, ytd, max. Keep start/end dates empty if you want to return values for this period. Use either Period or Date Range. Ignored when both dates are provided. The form is prefilled with 1y; if period and dates are empty, 5d is used.",
              "default": "1y",
              "title": "Period"
            },
            "description": "Available options: 1d, 5d, 1mo, 3mo, 6mo, 1y, 2y, 5y, 10y, ytd, max. Keep start/end dates empty if you want to return values for this period. Use either Period or Date Range. Ignored when both dates are provided. The form is prefilled with 1y; if period and dates are empty, 5d is used."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Inclusive UTC date (YYYY-MM-DD). If both date range and period boxes are filled, date range is considered. Use either period or date range.",
              "title": "Start",
              "type": "string",
              "format": "date",
              "nullable": true
            },
            "description": "Inclusive UTC date (YYYY-MM-DD). If both date range and period boxes are filled, date range is considered. Use either period or date range."
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Exclusive UTC date (YYYY-MM-DD). If both date range and period boxes are filled, date range is considered. Use either period or date range.",
              "title": "End",
              "type": "string",
              "format": "date",
              "nullable": true
            },
            "description": "Exclusive UTC date (YYYY-MM-DD). If both date range and period boxes are filled, date range is considered. Use either period or date range."
          },
          {
            "name": "symbols",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "Comma-separated symbols. Add up to 20 symbols. Example: MSFT,TSLA,INFY.",
              "title": "Symbols"
            },
            "description": "Comma-separated symbols. Add up to 20 symbols. Example: MSFT,TSLA,INFY."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClosePoint": {
        "properties": {
          "timestamp": {
            "type": "integer",
            "title": "Timestamp"
          },
          "time_utc": {
            "type": "string",
            "title": "Time Utc"
          },
          "close": {
            "type": "number",
            "title": "Close"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "time_utc",
          "close"
        ],
        "title": "ClosePoint"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryResponse": {
        "properties": {
          "fetched_at_utc": {
            "type": "string",
            "title": "Fetched At Utc"
          },
          "data_calls": {
            "type": "integer",
            "title": "Data Calls"
          },
          "requested_symbols": {
            "type": "integer",
            "title": "Requested Symbols"
          },
          "successful_symbols": {
            "type": "integer",
            "title": "Successful Symbols"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/HistoryResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "fetched_at_utc",
          "data_calls",
          "requested_symbols",
          "successful_symbols",
          "results"
        ],
        "title": "HistoryResponse"
      },
      "HistoryResult": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "currency": {
            "title": "Currency",
            "type": "string",
            "nullable": true
          },
          "exchange_timezone": {
            "title": "Exchange Timezone",
            "type": "string",
            "nullable": true
          },
          "data": {
            "items": {
              "$ref": "#/components/schemas/ClosePoint"
            },
            "type": "array",
            "title": "Data"
          },
          "coverage_verified": {
            "type": "boolean",
            "title": "Coverage Verified"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "any_error": {
            "title": "Any Error",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "data",
          "coverage_verified",
          "warnings"
        ],
        "title": "HistoryResult"
      },
      "QuoteResponse": {
        "properties": {
          "fetched_at_utc": {
            "type": "string",
            "title": "Fetched At Utc"
          },
          "data_calls": {
            "type": "integer",
            "title": "Data Calls"
          },
          "requested_symbols": {
            "type": "integer",
            "title": "Requested Symbols"
          },
          "successful_symbols": {
            "type": "integer",
            "title": "Successful Symbols"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/QuoteResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "fetched_at_utc",
          "data_calls",
          "requested_symbols",
          "successful_symbols",
          "results"
        ],
        "title": "QuoteResponse"
      },
      "QuoteResult": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "price": {
            "title": "Price",
            "type": "number",
            "nullable": true
          },
          "price_time_utc": {
            "title": "Price Time Utc",
            "type": "string",
            "nullable": true
          },
          "currency": {
            "title": "Currency",
            "type": "string",
            "nullable": true
          },
          "any_error": {
            "title": "Any Error",
            "type": "string",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "symbol"
        ],
        "title": "QuoteResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://ydataquote.vercel.app"
    }
  ]
}
